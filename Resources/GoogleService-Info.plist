<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Silver Ray CRM Firebase Configuration (Project: silverrayrealtyweb)
  Before App Store build in Codemagic/Xcode, register iOS Bundle ID "com.silverray.crm"
  in Firebase Console -> silverrayrealtyweb -> Project Settings -> Add App (iOS)
  and replace this file with the downloaded GoogleService-Info.plist (containing your iOS GOOGLE_APP_ID and REVERSED_CLIENT_ID).
-->
<plist version="1.0">
<dict>
	<key>PROJECT_ID</key>
	<string>silverrayrealtyweb</string>
	<key>STORAGE_BUCKET</key>
	<string>silverrayrealtyweb.firebasestorage.app</string>
	<key>DATABASE_URL</key>
	<string>https://silverrayrealtyweb-default-rtdb.firebaseio.com</string>
	<key>GCM_SENDER_ID</key>
	<string>447577313585</string>
	<key>BUNDLE_ID</key>
	<string>com.silverray.crm</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
</dict>
</plist>
